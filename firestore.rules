rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // HELPER FUNCTIONS
    // =============================================

    /**
     * Check if user is authenticated
     */
    function isAuthenticated() {
      return request.auth != null;
    }

    /**
     * Check if user is the resource owner
     */
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    /**
     * Check if user has specific role
     */
    function hasRole(role) {
      return isAuthenticated()
        && request.auth.token.role != null
        && request.auth.token.role == role;
    }

    /**
     * Check if user has one of the allowed roles
     */
    function hasAnyRole(roles) {
      return isAuthenticated()
        && request.auth.token.role != null
        && request.auth.token.role in roles;
    }

    /**
     * Check if user is admin or super_admin
     */
    function isAdmin() {
      return hasAnyRole(['admin', 'super_admin']);
    }

    /**
     * Check if user owns the workspace
     */
    function ownsWorkspace(workspaceId) {
      return isAuthenticated()
        && request.auth.token.workspaceId != null
        && request.auth.token.workspaceId == workspaceId;
    }

    /**
     * Check if email is verified
     */
    function isEmailVerified() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    /**
     * Check if user has active status
     */
    function isActiveUser() {
      return isAuthenticated()
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active');
    }

    /**
     * Check if user has premium plan (basic or higher)
     */
    function hasPremiumPlan() {
      return isAuthenticated()
        && request.auth.token.subscriptionPlan != null
        && request.auth.token.subscriptionPlan in ['basic', 'premium', 'pro', 'enterprise'];
    }

    /**
     * Check if user has specific subscription plan
     */
    function hasSubscriptionPlan(plan) {
      return isAuthenticated()
        && request.auth.token.subscriptionPlan != null
        && request.auth.token.subscriptionPlan == plan;
    }

    // =============================================
    // USER MANAGEMENT
    // =============================================

    /**
     * User Profiles
     * Users can read and update their own profile
     * Admins can read and manage all profiles
     */
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email;

      allow update: if (isOwner(userId) && isActiveUser())
        || isAdmin();

      allow delete: if isAdmin();
    }

    /**
     * Workspaces
     * Users can only access their own workspace
     * Admins can access all workspaces
     */
    match /workspaces/{workspaceId} {
      allow read: if ownsWorkspace(workspaceId) || isAdmin();

      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if (ownsWorkspace(workspaceId) && isActiveUser())
        || isAdmin();

      allow delete: if isAdmin();
    }

    /**
     * Workspace Invitations
     * Users can read invitations sent to them
     * Workspace owners can create and manage invitations
     */
    match /workspace-invitations/{invitationId} {
      allow read: if isAuthenticated()
        && (request.auth.token.email == resource.data.invitedEmail
            || ownsWorkspace(resource.data.workspaceId)
            || isAdmin());

      allow create: if isAuthenticated()
        && ownsWorkspace(request.resource.data.workspaceId);

      allow update: if isAuthenticated()
        && (request.auth.token.email == resource.data.invitedEmail
            || ownsWorkspace(resource.data.workspaceId)
            || isAdmin());

      allow delete: if isAdmin();
    }

    /**
     * API Keys
     * Users can manage their workspace API keys
     * Admins can manage all API keys
     */
    match /apiKeys/{keyId} {
      allow read: if ownsWorkspace(resource.data.workspaceId) || isAdmin();

      allow create: if isAuthenticated()
        && isEmailVerified()
        && ownsWorkspace(request.resource.data.workspaceId);

      allow update: if ownsWorkspace(resource.data.workspaceId) || isAdmin();

      allow delete: if ownsWorkspace(resource.data.workspaceId) || isAdmin();
    }

    // =============================================
    // PROPERTY DATA
    // =============================================

    /**
     * Properties Collection
     * Public read for all users (marketplace data)
     * Agents can create/update their own listings
     * Functions can write for extracted data
     */
    match /properties/{propertyId} {
      // Public read for browsing
      allow read: if true;

      // Agents can create their own listings
      allow create: if hasAnyRole(['agent', 'admin', 'super_admin'])
        && isActiveUser()
        && request.resource.data.metadata.agentId == request.auth.uid;

      // Agents can update their own listings
      allow update: if hasAnyRole(['agent', 'admin', 'super_admin'])
        && isActiveUser()
        && resource.data.metadata.agentId == request.auth.uid;

      // Agents can delete their own listings
      allow delete: if hasAnyRole(['agent', 'admin', 'super_admin'])
        && resource.data.metadata.agentId == request.auth.uid;

      // Note: Cloud Functions can bypass these rules with admin SDK
    }

    /**
     * Extraction Jobs
     * Users can view all jobs (for transparency)
     * Only authenticated users can create jobs
     * Functions manage job status
     */
    match /extraction-jobs/{jobId} {
      allow read: if true; // Public read for transparency

      allow create: if isAuthenticated() && isActiveUser();

      // Only functions update jobs (status, results, etc.)
      allow update, delete: if false;
    }

    // =============================================
    // USER-SPECIFIC DATA (WORKSPACE ISOLATION)
    // =============================================

    /**
     * Saved Searches
     * Users can only access searches in their workspace
     */
    match /savedSearches/{searchId} {
      allow read: if ownsWorkspace(resource.data.workspaceId) || isAdmin();

      allow create: if isAuthenticated()
        && isActiveUser()
        && ownsWorkspace(request.resource.data.workspaceId)
        && request.resource.data.userId == request.auth.uid;

      allow update: if isActiveUser()
        && ownsWorkspace(resource.data.workspaceId)
        && resource.data.userId == request.auth.uid;

      allow delete: if ownsWorkspace(resource.data.workspaceId)
        && resource.data.userId == request.auth.uid;
    }

    /**
     * Favorites
     * Users can only access favorites in their workspace
     */
    match /favorites/{favoriteId} {
      allow read: if ownsWorkspace(resource.data.workspaceId) || isAdmin();

      allow create: if isAuthenticated()
        && isActiveUser()
        && ownsWorkspace(request.resource.data.workspaceId)
        && request.resource.data.userId == request.auth.uid;

      allow delete: if ownsWorkspace(resource.data.workspaceId)
        && resource.data.userId == request.auth.uid;
    }

    /**
     * User Preferences
     * Users can read/write their own preferences
     */
    match /user-preferences/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow write: if isOwner(userId) && isActiveUser();
    }

    /**
     * Property Interactions
     * Users can read/write their own interactions
     * Used for recommendation engine
     */
    match /property-interactions/{interactionId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isAuthenticated()
        && isActiveUser()
        && request.resource.data.userId == request.auth.uid;

      // Interactions are immutable after creation
      allow update, delete: if false;
    }

    /**
     * Generated Responses
     * Users can read their own generated responses
     * Functions create responses
     */
    match /generated-responses/{responseId} {
      allow read: if isAuthenticated()
        && (ownsWorkspace(resource.data.workspaceId) || isAdmin());

      // Functions create responses
      allow create: if false;

      // Users can mark responses as sent
      allow update: if isAuthenticated()
        && ownsWorkspace(resource.data.workspaceId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sent', 'sentAt']);

      allow delete: if false;
    }

    // =============================================
    // AGENT-SPECIFIC FEATURES
    // =============================================

    /**
     * Clients (for agents)
     * Agents can manage their client list
     */
    match /clients/{clientId} {
      allow read: if hasAnyRole(['agent', 'admin', 'super_admin'])
        && (resource.data.agentId == request.auth.uid || isAdmin());

      allow create: if hasAnyRole(['agent', 'admin', 'super_admin'])
        && isActiveUser()
        && request.resource.data.agentId == request.auth.uid;

      allow update: if hasAnyRole(['agent', 'admin', 'super_admin'])
        && isActiveUser()
        && resource.data.agentId == request.auth.uid;

      allow delete: if hasAnyRole(['agent', 'admin', 'super_admin'])
        && resource.data.agentId == request.auth.uid;
    }

    /**
     * Agent Analytics
     * Agents can view their own analytics
     */
    match /agent-analytics/{agentId} {
      allow read: if isOwner(agentId) || isAdmin();

      // Functions update analytics
      allow write: if false;
    }

    // =============================================
    // LEGACY COLLECTIONS (BACKWARD COMPATIBILITY)
    // =============================================

    /**
     * Legacy houses collection
     * Kept for backward compatibility
     */
    match /houses/{houseId} {
      allow read: if true;

      allow write: if isAuthenticated() && isActiveUser();
    }

    /**
     * Search requests
     * User-specific search history
     */
    match /search-requests/{requestId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isAuthenticated()
        && isActiveUser()
        && request.resource.data.userId == request.auth.uid;

      allow update, delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    // =============================================
    // ADMIN-ONLY COLLECTIONS
    // =============================================

    /**
     * System Audit Logs
     * Only admins can read
     */
    match /audit-logs/{logId} {
      allow read: if isAdmin();

      // Functions write audit logs
      allow write: if false;
    }

    /**
     * System Configuration
     * Only super admins can manage
     */
    match /system-config/{configId} {
      allow read: if isAdmin();

      allow write: if hasRole('super_admin');
    }

    // =============================================
    // MONETIZATION
    // =============================================

    /**
     * Subscriptions
     * Users can read their own subscription
     * Only functions can create/update
     */
    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin());

      // Only functions can write subscriptions
      allow write: if false;
    }

    /**
     * Payment Intents
     * Users can read their own payment intents
     */
    match /payment_intents/{paymentId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      // Only functions update payment status
      allow update, delete: if false;
    }

    /**
     * Payment Methods
     * Users can manage their own payment methods
     */
    match /payment_methods/{methodId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isAuthenticated()
        && isEmailVerified()
        && request.resource.data.userId == request.auth.uid;

      allow update, delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    /**
     * Promoted Listings
     * Agents can promote their listings
     * Everyone can view promotions (for display)
     */
    match /promoted_listings/{promotionId} {
      allow read: if true; // Public read for displaying promoted properties

      allow create: if hasAnyRole(['agent', 'admin', 'super_admin'])
        && isActiveUser()
        && request.resource.data.userId == request.auth.uid;

      allow update: if hasAnyRole(['agent', 'admin', 'super_admin'])
        && resource.data.userId == request.auth.uid;

      allow delete: if hasAnyRole(['agent', 'admin', 'super_admin'])
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    /**
     * Ad Placements
     * Admins manage ads
     * Users see ads based on their plan
     */
    match /ad_placements/{adId} {
      allow read: if true; // Public read for displaying ads

      allow write: if isAdmin(); // Only admins manage ads
    }

    /**
     * Usage Tracking
     * Users can read their own usage
     * Functions track usage
     */
    match /usage_tracking/{usageId} {
      allow read: if isAuthenticated()
        && (usageId.matches(request.auth.token.workspaceId + '_.*') || isAdmin());

      // Only functions track usage
      allow write: if false;
    }

    /**
     * Waiting Content - Language Lessons
     * Premium users get access to all content
     * Free users get limited access
     */
    match /waiting_content_language/{lessonId} {
      allow read: if isAuthenticated()
        && (hasPremiumPlan() || resource.data.difficulty == 'beginner');
    }

    /**
     * Waiting Content - Cultural Insights
     */
    match /waiting_content_culture/{insightId} {
      allow read: if isAuthenticated();
    }

    /**
     * Waiting Content - Food Culture
     */
    match /waiting_content_food/{foodId} {
      allow read: if isAuthenticated();
    }

    /**
     * Waiting Content - Local Tips
     */
    match /waiting_content_tips/{tipId} {
      allow read: if isAuthenticated();

      // Users can upvote tips
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes']);
    }

    /**
     * Waiting Content - Moving Checklist
     */
    match /waiting_content_moving/{itemId} {
      allow read: if isAuthenticated();
    }

    /**
     * Waiting Content - Design Inspiration
     */
    match /waiting_content_design/{designId} {
      allow read: if isAuthenticated();

      // Users can save designs
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saves']);
    }

    /**
     * Waiting Content Progress
     * Users can read and update their own progress
     */
    match /waiting_content_progress/{userId} {
      allow read: if isAuthenticated()
        && (userId == request.auth.uid || isAdmin());

      allow write: if isAuthenticated()
        && userId == request.auth.uid;
    }

    /**
     * Invoices
     * Users can read their own invoices
     */
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin());

      // Only functions generate invoices
      allow write: if false;
    }

    // =============================================
    // AI & ML FEATURES
    // =============================================

    /**
     * Property Recommendations
     * Users can read their own recommendations
     */
    match /property_recommendations/{recommendationId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;

      // Users can update viewed/dismissed status
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['viewedAt', 'dismissedAt', 'savedAt']);

      allow write: if false; // Only functions create recommendations
    }

    /**
     * User Preferences (for ML model)
     * Users can read and update their own preferences
     */
    match /user_preferences/{userId} {
      allow read, write: if isAuthenticated()
        && userId == request.auth.uid;
    }

    /**
     * Chat Conversations (AI Chatbot)
     * Users can read and update their own conversations
     */
    match /chat_conversations/{conversationId} {
      allow read, write: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    /**
     * Property Valuations (AVM)
     * Users can read valuations, only functions can write
     */
    match /property_valuations/{valuationId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only functions create valuations
    }

    /**
     * Smart Alerts
     * Users can read their own alerts
     */
    match /smart_alerts/{alertId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;

      // Users can mark as read
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['readAt', 'clickedAt']);

      allow create, delete: if false; // Only functions manage alerts
    }

    // =============================================
    // COMMUNICATION FEATURES
    // =============================================

    /**
     * Messages
     * Users can read messages in their conversations
     */
    match /messages/{messageId} {
      allow read: if isAuthenticated()
        && (resource.data.senderId == request.auth.uid
            || get(/databases/$(database)/documents/conversations/$(resource.data.conversationId))
               .data.participants[request.auth.uid] != null);

      // Users can create messages in their conversations
      allow create: if isAuthenticated()
        && request.resource.data.senderId == request.auth.uid;

      // Users can update read/delivered status
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'deliveredAt', 'readAt', 'reactions']);
    }

    /**
     * Conversations
     * Users can read their own conversations
     */
    match /conversations/{conversationId} {
      allow read: if isAuthenticated()
        && resource.data.participants[request.auth.uid] != null;

      // Users can create conversations
      allow create: if isAuthenticated()
        && request.resource.data.participants[request.auth.uid] != null;

      // Participants can update conversation settings
      allow update: if isAuthenticated()
        && resource.data.participants[request.auth.uid] != null;
    }

    /**
     * Video Calls
     * Users can read their own calls
     */
    match /video_calls/{callId} {
      allow read: if isAuthenticated()
        && (resource.data.hostId == request.auth.uid
            || resource.data.participants[request.auth.uid] != null);

      allow create: if isAuthenticated()
        && request.resource.data.hostId == request.auth.uid;

      allow update: if isAuthenticated()
        && (resource.data.hostId == request.auth.uid
            || resource.data.participants[request.auth.uid] != null);
    }

    /**
     * Appointments
     * Users can read their own appointments
     */
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated()
        && (resource.data.requesterId == request.auth.uid
            || resource.data.agentId == request.auth.uid
            || resource.data.attendees[request.auth.uid] != null);

      // Users can create appointment requests
      allow create: if isAuthenticated()
        && request.resource.data.requesterId == request.auth.uid;

      // Participants can update status
      allow update: if isAuthenticated()
        && (resource.data.requesterId == request.auth.uid
            || resource.data.agentId == request.auth.uid);
    }

    /**
     * Shared Documents
     * Users can read documents shared with them
     */
    match /shared_documents/{documentId} {
      allow read: if isAuthenticated()
        && (resource.data.uploadedBy == request.auth.uid
            || resource.data.sharedWith[request.auth.uid] != null
            || (resource.data.workspaceId != null
                && get(/databases/$(database)/documents/workspace_members/$(request.auth.uid + '_' + resource.data.workspaceId)) != null));

      allow create: if isAuthenticated()
        && request.resource.data.uploadedBy == request.auth.uid;

      allow update: if isAuthenticated()
        && (resource.data.uploadedBy == request.auth.uid
            || (resource.data.sharedWith[request.auth.uid] != null
                && resource.data.sharedWith[request.auth.uid].accessLevel == 'edit'));
    }

    /**
     * Notification Preferences
     * Users can manage their own preferences
     */
    match /notification_preferences/{userId} {
      allow read, write: if isAuthenticated()
        && userId == request.auth.uid;
    }

    // =============================================
    // ANALYTICS FEATURES
    // =============================================

    /**
     * Market Analytics
     * Public read for all authenticated users
     */
    match /market_analytics/{analyticsId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only functions update market data
    }

    /**
     * Neighborhood Insights
     * Public read for all authenticated users
     */
    match /neighborhood_insights/{insightId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only functions update insights
    }

    /**
     * Price History
     * Public read for all authenticated users
     */
    match /price_history/{historyId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only functions track price history
    }

    /**
     * Investment Analysis
     * Users can read their own analyses
     */
    match /investment_analysis/{analysisId} {
      allow read, write: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    /**
     * Commute Analysis
     * Users can read their own analyses
     */
    match /commute_analysis/{analysisId} {
      allow read, write: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    /**
     * Property Comparisons
     * Users can manage their own comparisons
     */
    match /property_comparisons/{comparisonId} {
      allow read, write: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    // =============================================
    // FINANCIAL TOOLS
    // =============================================

    /**
     * Mortgage Calculations
     * Users can read their own calculations
     */
    match /mortgage_calculations/{calculationId} {
      allow read, write: if isAuthenticated()
        && (!resource.data.keys().hasAny(['userId'])
            || resource.data.userId == request.auth.uid);
    }

    /**
     * Amortization Schedules
     * Users can read their own schedules
     */
    match /amortization_schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    /**
     * Pre-Approvals
     * Users can manage their own pre-approvals
     */
    match /pre_approvals/{approvalId} {
      allow read, write: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    /**
     * Assistance Programs
     * Public read for all authenticated users
     */
    match /assistance_programs/{programId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin(); // Only admins manage programs
    }

    /**
     * Closing Cost Estimates
     * Users can manage their own estimates
     */
    match /closing_cost_estimates/{estimateId} {
      allow read, write: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    /**
     * Rent vs Buy Analysis
     * Users can manage their own analyses
     */
    match /rent_vs_buy_analysis/{analysisId} {
      allow read, write: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    /**
     * Affordability Calculations
     * Users can read their own calculations
     */
    match /affordability_calculations/{calculationId} {
      allow read, write: if isAuthenticated()
        && (!resource.data.keys().hasAny(['userId'])
            || resource.data.userId == request.auth.uid);
    }

    // =============================================
    // SOCIAL & COMMUNITY FEATURES
    // =============================================

    /**
     * Reviews
     * All users can read reviews
     * Users can create and manage their own reviews
     */
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated()
        && (resource.data.userId == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['helpfulCount', 'notHelpfulCount']));

      allow delete: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    /**
     * Forum Posts
     * All users can read posts
     * Users can create and manage their own posts
     */
    match /forum_posts/{postId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.authorId == request.auth.uid;

      allow update: if isAuthenticated()
        && (resource.data.authorId == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['views', 'likes']));

      allow delete: if isAuthenticated()
        && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    /**
     * Forum Comments
     * All users can read comments
     * Users can create and manage their own comments
     */
    match /forum_comments/{commentId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.authorId == request.auth.uid;

      allow update: if isAuthenticated()
        && (resource.data.authorId == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['likes']));

      allow delete: if isAuthenticated()
        && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    /**
     * Resident Insights
     * All users can read insights
     * Users can create and manage their own insights
     */
    match /resident_insights/{insightId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated()
        && (resource.data.userId == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['helpfulCount']));

      allow delete: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    /**
     * Shared Property Lists
     * Users can read lists shared with them
     */
    match /shared_property_lists/{listId} {
      allow read: if isAuthenticated()
        && (resource.data.ownerId == request.auth.uid
            || resource.data.collaborators[request.auth.uid] != null
            || resource.data.visibility == 'public');

      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if isAuthenticated()
        && (resource.data.ownerId == request.auth.uid
            || resource.data.collaborators[request.auth.uid] != null);

      allow delete: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid;
    }

    /**
     * Agent Profiles
     * All users can read agent profiles
     * Agents can manage their own profiles
     */
    match /agent_profiles/{profileId} {
      allow read: if isAuthenticated();

      allow write: if isAuthenticated()
        && (profileId == request.auth.uid
            || hasAnyRole(['agent', 'admin', 'super_admin']));
    }

    /**
     * Activity Feed
     * Users can read their own activity and public activities
     */
    match /activity_feed/{activityId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid
            || resource.data.visibility == 'public');

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      allow update, delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    /**
     * User Connections
     * Users can manage their own connections
     */
    match /user_connections/{connectionId} {
      allow read: if isAuthenticated()
        && (resource.data.requesterId == request.auth.uid
            || resource.data.addresseeId == request.auth.uid);

      allow create: if isAuthenticated()
        && request.resource.data.requesterId == request.auth.uid;

      allow update: if isAuthenticated()
        && (resource.data.requesterId == request.auth.uid
            || resource.data.addresseeId == request.auth.uid);
    }

    /**
     * Referrals
     * Users can read their own referrals
     */
    match /referrals/{referralId} {
      allow read: if isAuthenticated()
        && (resource.data.referrerId == request.auth.uid
            || resource.data.refereeId == request.auth.uid);

      allow create: if isAuthenticated()
        && request.resource.data.referrerId == request.auth.uid;

      allow update: if isAuthenticated()
        && (resource.data.referrerId == request.auth.uid
            || resource.data.refereeId == request.auth.uid
            || isAdmin());
    }

    // =============================================
    // MOBILE FEATURES
    // =============================================

    /**
     * AR Sessions
     * Users can manage their own AR sessions
     */
    match /ar_sessions/{sessionId} {
      allow read, write: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    /**
     * Geolocation Searches
     * Users can read their own searches
     */
    match /geolocation_searches/{searchId} {
      allow read, write: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    /**
     * Offline Data Sync
     * Users can manage their own sync data
     */
    match /offline_data_sync/{syncId} {
      allow read, write: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    /**
     * Push Notifications
     * Users can read their own notifications
     */
    match /push_notifications/{notificationId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;

      // Users can mark as clicked
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['devices']);

      allow create, delete: if false; // Only functions send notifications
    }

    /**
     * Device Registrations
     * Users can manage their own devices
     */
    match /device_registrations/{deviceId} {
      allow read, write: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    /**
     * Quick Actions
     * Users can manage their own quick actions
     */
    match /quick_actions/{actionId} {
      allow read, write: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    /**
     * Voice Commands
     * Users can manage their own voice commands
     */
    match /voice_commands/{commandId} {
      allow read, write: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    /**
     * Photo Analysis
     * Users can manage their own photo analyses
     */
    match /photo_analysis/{analysisId} {
      allow read, write: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    /**
     * Biometric Auth
     * Users can manage their own biometric settings
     */
    match /biometric_auth/{authId} {
      allow read, write: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    /**
     * Widget Data
     * Users can read their own widget data
     */
    match /widget_data/{widgetId} {
      allow read, write: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    /**
     * Location Reminders
     * Users can manage their own location reminders
     */
    match /location_reminders/{reminderId} {
      allow read, write: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    // =============================================
    // ADMIN & MANAGEMENT FEATURES
    // =============================================

    /**
     * User Management Actions
     * Only admins can perform user management actions
     */
    match /user_management_actions/{actionId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.adminId == request.auth.uid;
    }

    /**
     * Moderation Queue
     * Moderators and admins can access
     */
    match /moderation_queue/{itemId} {
      allow read: if hasAnyRole(['moderator', 'admin', 'super_admin']);
      allow create: if false; // Auto-created by system
      allow update: if hasAnyRole(['moderator', 'admin', 'super_admin']);
    }

    /**
     * System Configuration
     * Only super admins can modify
     */
    match /system_config/{configId} {
      allow read: if isAdmin();
      allow write: if hasRole('super_admin');
    }

    /**
     * Audit Logs
     * Admins can read, system writes
     */
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only functions write logs
    }

    /**
     * Admin Analytics
     * Admins can read
     */
    match /admin_analytics/{analyticsId} {
      allow read: if isAdmin();
      allow write: if false; // Generated by functions
    }

    /**
     * Bulk Operations
     * Admins can create and manage
     */
    match /bulk_operations/{operationId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.initiatedBy == request.auth.uid;
      allow update: if isAdmin();
    }

    /**
     * System Health
     * Admins can read
     */
    match /system_health/{healthId} {
      allow read: if isAdmin();
      allow write: if false; // Updated by monitoring functions
    }

    /**
     * Feature Usage
     * Admins can read
     */
    match /feature_usage/{usageId} {
      allow read: if isAdmin();
      allow write: if false; // Tracked by system
    }

    /**
     * Support Tickets
     * Users can read their own, support staff can read all
     */
    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid
            || hasAnyRole(['support', 'admin', 'super_admin']));

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated()
        && (resource.data.userId == request.auth.uid
            || hasAnyRole(['support', 'admin', 'super_admin']));
    }

    // =============================================
    // INTEGRATION FEATURES
    // =============================================

    /**
     * Data Imports
     * Users can read their own imports
     */
    match /data_imports/{importId} {
      allow read: if isAuthenticated()
        && (resource.data.initiatedBy == request.auth.uid
            || resource.data.workspaceId == request.auth.token.workspaceId
            || isAdmin());

      allow create: if isAuthenticated()
        && request.resource.data.initiatedBy == request.auth.uid;

      allow update: if isAuthenticated()
        && resource.data.initiatedBy == request.auth.uid;
    }

    /**
     * Data Exports
     * Users can read their own exports
     */
    match /data_exports/{exportId} {
      allow read: if isAuthenticated()
        && (resource.data.requestedBy == request.auth.uid
            || resource.data.workspaceId == request.auth.token.workspaceId
            || isAdmin());

      allow create: if isAuthenticated()
        && request.resource.data.requestedBy == request.auth.uid;
    }

    /**
     * Integration Connections
     * Workspace members can manage
     */
    match /integration_connections/{connectionId} {
      allow read, write: if isAuthenticated()
        && (resource.data.userId == request.auth.uid
            || resource.data.workspaceId == request.auth.token.workspaceId);
    }

    /**
     * Sync Jobs
     * Auto-managed by system
     */
    match /sync_jobs/{jobId} {
      allow read: if isAuthenticated()
        && (resource.data.workspaceId == request.auth.token.workspaceId
            || isAdmin());
      allow write: if false; // System managed
    }

    /**
     * MLS Connections
     * Workspace admins can manage
     */
    match /mls_connections/{connectionId} {
      allow read: if isAuthenticated()
        && resource.data.workspaceId == request.auth.token.workspaceId;

      allow write: if isAuthenticated()
        && resource.data.workspaceId == request.auth.token.workspaceId
        && hasAnyRole(['agent', 'admin', 'super_admin']);
    }

    /**
     * API Keys
     * Users can manage their own API keys
     */
    match /api_keys/{keyId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid
            || resource.data.workspaceId == request.auth.token.workspaceId);

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      allow update, delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    /**
     * Workflow Connectors
     * Users can manage their own connectors
     */
    match /workflow_connectors/{connectorId} {
      allow read, write: if isAuthenticated()
        && (resource.data.userId == request.auth.uid
            || resource.data.workspaceId == request.auth.token.workspaceId);
    }

    /**
     * Backups
     * Admins only
     */
    match /backups/{backupId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.initiatedBy == request.auth.uid;
    }

    // =============================================
    // WEBHOOK & API FEATURES
    // =============================================

    /**
     * Webhooks
     * Users can manage their own webhooks
     */
    match /webhooks/{webhookId} {
      allow read, write: if isAuthenticated()
        && (resource.data.userId == request.auth.uid
            || resource.data.workspaceId == request.auth.token.workspaceId);
    }

    /**
     * Webhook Deliveries
     * Read-only for webhook owners
     */
    match /webhook_deliveries/{deliveryId} {
      allow read: if isAuthenticated();
      allow write: if false; // System managed
    }

    /**
     * API Usage
     * Users can read their own usage
     */
    match /api_usage/{usageId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // System tracked
    }

    /**
     * Rate Limit Status
     * Users can read their own rate limit status
     */
    match /rate_limit_status/{userId} {
      allow read: if isAuthenticated()
        && (userId == request.auth.uid || isAdmin());
      allow write: if false; // System managed
    }

    /**
     * API Request Logs
     * Admins only
     */
    match /api_request_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // System logged
    }

    /**
     * API Endpoints (Documentation)
     * Public read
     */
    match /api_endpoints/{endpointId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /**
     * SDK Usage
     * System tracked
     */
    match /sdk_usage/{usageId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow write: if false; // System tracked
    }

    /**
     * IP Access Control
     * Admins only
     */
    match /ip_access_control/{ruleId} {
      allow read: if isAdmin();
      allow write: if hasRole('super_admin');
    }

    // =============================================
    // AUTOMATION FEATURES
    // =============================================

    /**
     * Workflows
     * Users can manage their own workflows
     */
    match /workflows/{workflowId} {
      allow read, write: if isAuthenticated()
        && (resource.data.workspaceId == request.auth.token.workspaceId
            || resource.data.createdBy == request.auth.uid);
    }

    /**
     * Workflow Executions
     * Read-only for workflow owners
     */
    match /workflow_executions/{executionId} {
      allow read: if isAuthenticated()
        && resource.data.workspaceId == request.auth.token.workspaceId;
      allow write: if false; // System managed
    }

    /**
     * Email Campaigns
     * Users can manage their own campaigns
     */
    match /email_campaigns/{campaignId} {
      allow read, write: if isAuthenticated()
        && (resource.data.workspaceId == request.auth.token.workspaceId
            || resource.data.createdBy == request.auth.uid);
    }

    /**
     * Email Templates
     * Workspace members can read, admins can write
     */
    match /email_templates/{templateId} {
      allow read: if isAuthenticated()
        && resource.data.workspaceId == request.auth.token.workspaceId;

      allow write: if isAuthenticated()
        && resource.data.workspaceId == request.auth.token.workspaceId
        && hasAnyRole(['admin', 'super_admin']);
    }

    /**
     * SMS Campaigns
     * Users can manage their own campaigns
     */
    match /sms_campaigns/{campaignId} {
      allow read, write: if isAuthenticated()
        && (resource.data.workspaceId == request.auth.token.workspaceId
            || resource.data.createdBy == request.auth.uid);
    }

    /**
     * Automated Tasks
     * Workspace members can read, admins can write
     */
    match /automated_tasks/{taskId} {
      allow read: if isAuthenticated()
        && resource.data.workspaceId == request.auth.token.workspaceId;

      allow write: if isAuthenticated()
        && resource.data.workspaceId == request.auth.token.workspaceId
        && hasAnyRole(['admin', 'super_admin']);
    }

    /**
     * Lead Scoring Rules
     * Workspace members can read, admins can write
     */
    match /lead_scoring_rules/{ruleId} {
      allow read: if isAuthenticated()
        && resource.data.workspaceId == request.auth.token.workspaceId;

      allow write: if isAuthenticated()
        && resource.data.workspaceId == request.auth.token.workspaceId
        && hasAnyRole(['admin', 'super_admin']);
    }

    /**
     * Notification Rules
     * Users can manage their own rules
     */
    match /notification_rules/{ruleId} {
      allow read, write: if isAuthenticated()
        && (resource.data.workspaceId == request.auth.token.workspaceId
            || resource.data.createdBy == request.auth.uid);
    }

    // =============================================
    // REPORTING FEATURES
    // =============================================

    /**
     * Custom Reports
     * Users can read their own and workspace reports
     */
    match /custom_reports/{reportId} {
      allow read: if isAuthenticated()
        && (resource.data.createdBy == request.auth.uid
            || resource.data.workspaceId == request.auth.token.workspaceId
            || (resource.data.sharing.visibility == 'public'));

      allow create: if isAuthenticated()
        && request.resource.data.createdBy == request.auth.uid;

      allow update, delete: if isAuthenticated()
        && resource.data.createdBy == request.auth.uid;
    }

    /**
     * Report Executions
     * Users can read their own executions
     */
    match /report_executions/{executionId} {
      allow read: if isAuthenticated()
        && (resource.data.executedBy == request.auth.uid
            || resource.data.workspaceId == request.auth.token.workspaceId);

      allow create: if isAuthenticated()
        && request.resource.data.executedBy == request.auth.uid;
    }

    /**
     * Dashboards
     * Users can read their own and workspace dashboards
     */
    match /dashboards/{dashboardId} {
      allow read: if isAuthenticated()
        && (resource.data.createdBy == request.auth.uid
            || resource.data.workspaceId == request.auth.token.workspaceId
            || (resource.data.visibility == 'public'));

      allow create: if isAuthenticated()
        && request.resource.data.createdBy == request.auth.uid;

      allow update, delete: if isAuthenticated()
        && resource.data.createdBy == request.auth.uid;
    }

    /**
     * Pre-generated Reports
     * Workspace members can read
     */
    match /sales_pipeline_reports/{reportId} {
      allow read: if isAuthenticated()
        && resource.data.workspaceId == request.auth.token.workspaceId;
      allow write: if false; // Generated by system
    }

    match /property_performance_reports/{reportId} {
      allow read: if isAuthenticated()
        && resource.data.workspaceId == request.auth.token.workspaceId;
      allow write: if false; // Generated by system
    }

    match /user_engagement_reports/{reportId} {
      allow read: if isAdmin();
      allow write: if false; // Generated by system
    }

    match /financial_reports/{reportId} {
      allow read: if isAdmin();
      allow write: if false; // Generated by system
    }

    /**
     * Scheduled Reports
     * Users can manage their own scheduled reports
     */
    match /scheduled_reports/{scheduleId} {
      allow read, write: if isAuthenticated()
        && (resource.data.createdBy == request.auth.uid
            || resource.data.workspaceId == request.auth.token.workspaceId);
    }

    // =============================================
    // I18N & ACCESSIBILITY FEATURES
    // =============================================

    /**
     * Translations
     * Public read, admins can write
     */
    match /translations/{translationId} {
      allow read: if true;
      allow write: if hasAnyRole(['translator', 'admin', 'super_admin']);
    }

    /**
     * Locale Configurations
     * Public read, admins can write
     */
    match /locale_configs/{localeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /**
     * User Language Preferences
     * Users can manage their own preferences
     */
    match /user_language_preferences/{userId} {
      allow read, write: if isAuthenticated()
        && userId == request.auth.uid;
    }

    /**
     * Accessibility Settings
     * Users can manage their own settings
     */
    match /accessibility_settings/{userId} {
      allow read, write: if isAuthenticated()
        && userId == request.auth.uid;
    }

    /**
     * Content Translation Requests
     * Users can read their own requests
     */
    match /content_translation_requests/{requestId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
    }

    /**
     * RTL Settings
     * Public read, admins can write
     */
    match /rtl_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /**
     * Keyboard Shortcuts
     * Public read for defaults, users can customize
     */
    match /keyboard_shortcuts/{shortcutId} {
      allow read: if true;
      allow update: if isAuthenticated()
        && request.resource.data.userCustomized == true;
    }

    /**
     * WCAG Compliance Reports
     * Admins only
     */
    match /wcag_compliance_reports/{reportId} {
      allow read: if isAdmin();
      allow write: if false; // Generated by automated tools
    }

    /**
     * Text-to-Speech Settings
     * Users can manage their own settings
     */
    match /text_to_speech_settings/{userId} {
      allow read, write: if isAuthenticated()
        && userId == request.auth.uid;
    }

    /**
     * Translation Memory
     * Translators and admins can access
     */
    match /translation_memory/{memoryId} {
      allow read: if hasAnyRole(['translator', 'admin', 'super_admin']);
      allow write: if hasAnyRole(['translator', 'admin', 'super_admin']);
    }

    // =============================================
    // EDUCATION & SCHOOLS
    // =============================================

    /**
     * School Information
     * Public read for all authenticated users
     * System managed data
     */
    match /schools/{schoolId} {
      allow read: if isAuthenticated();
      allow write: if false; // System managed via API integration
    }

    /**
     * Property School Assignments
     * Public read for property shoppers
     */
    match /property_school_assignments/{propertyId} {
      allow read: if isAuthenticated();
      allow write: if false; // System calculated
    }

    /**
     * School Comparisons
     * Users can create and manage their own comparisons
     */
    match /school_comparisons/{comparisonId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      allow update, delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    // =============================================
    // INVESTMENT & PORTFOLIO
    // =============================================

    /**
     * Rental Market Analysis
     * Users can read analyses for properties they're viewing
     */
    match /rental_market_analysis/{analysisId} {
      allow read: if isAuthenticated();
      allow write: if false; // Generated by functions
    }

    /**
     * Rental Comparison Reports
     * Users can manage their own reports
     */
    match /rental_comparison_reports/{reportId} {
      allow read, write: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    /**
     * Owned Properties (Portfolio)
     * Users can manage their own portfolio
     */
    match /owned_properties/{propertyId} {
      allow read, write: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    /**
     * Portfolio Dashboards
     * User-specific portfolio data
     */
    match /portfolio_dashboards/{userId} {
      allow read, write: if isAuthenticated()
        && userId == request.auth.uid;
    }

    /**
     * Portfolio Analysis Reports
     * Users can read their own reports
     */
    match /portfolio_analysis_reports/{reportId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow write: if false; // Generated by functions
    }

    // =============================================
    // INFRASTRUCTURE
    // =============================================

    /**
     * Internet Availability
     * Public read for property research
     */
    match /internet_availability/{address} {
      allow read: if isAuthenticated();
      allow write: if false; // System managed via API
    }

    /**
     * Speed Test Results
     * Users can contribute speed tests
     */
    match /speed_test_results/{testId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.testedBy == request.auth.uid;
    }

    // =============================================
    // INTERNATIONAL
    // =============================================

    /**
     * Exchange Rates
     * Public read for all users
     */
    match /exchange_rates/{rateId} {
      allow read: if true;
      allow write: if false; // System updated
    }

    /**
     * User Currency Preferences
     * Users manage their own preferences
     */
    match /user_currency_preferences/{userId} {
      allow read, write: if isAuthenticated()
        && userId == request.auth.uid;
    }

    // =============================================
    // ROOMMATE MATCHING
    // =============================================

    /**
     * Roommate Profiles
     * Users can manage their own profile
     * Others can read if actively searching
     */
    match /roommate_profiles/{profileId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid
            || resource.data.status == 'searching');

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid;

      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    /**
     * Roommate Matches
     * Users can see matches they're part of
     */
    match /roommate_matches/{matchId} {
      allow read: if isAuthenticated()
        && request.auth.uid in resource.data.users;

      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.users;

      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.users;
    }

    /**
     * Roommate Agreements
     * Users can read agreements they're part of
     */
    match /roommate_agreements/{agreementId} {
      allow read: if isAuthenticated()
        && request.auth.uid in get(/databases/$(database)/documents/roommate_matches/$(resource.data.matchId)).data.users;

      allow create, update: if isAuthenticated()
        && request.auth.uid in get(/databases/$(database)/documents/roommate_matches/$(resource.data.matchId)).data.users;
    }

    // =============================================
    // LUXURY & CONCIERGE
    // =============================================

    /**
     * Concierge Requests
     * Users can manage their own requests
     * Assigned concierges can access
     */
    match /concierge_requests/{requestId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid
            || (resource.data.assignedConcierge != null
                && resource.data.assignedConcierge.id == request.auth.uid)
            || hasAnyRole(['concierge', 'admin', 'super_admin']));

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated()
        && (resource.data.userId == request.auth.uid
            || hasAnyRole(['concierge', 'admin', 'super_admin']));
    }

    /**
     * Off-Market Listings
     * Restricted access based on qualification
     */
    match /off_market_listings/{listingId} {
      allow read: if isAuthenticated()
        && (hasAnyRole(['agent', 'admin', 'super_admin'])
            || resource.data.accessLevel == 'verified_buyers'
            || (resource.data.accessRequests != null
                && resource.data.accessRequests[request.auth.uid] != null
                && resource.data.accessRequests[request.auth.uid].approved == true));

      allow write: if hasAnyRole(['agent', 'admin', 'super_admin']);
    }

    /**
     * NDAs (Non-Disclosure Agreements)
     * Users can read their own NDAs
     */
    match /ndas/{ndaId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      allow update: if hasAnyRole(['admin', 'super_admin']); // For revocation
    }

    /**
     * VIP Buyer Profiles
     * Users can read/update their own profile
     */
    match /vip_buyer_profiles/{userId} {
      allow read, write: if isAuthenticated()
        && userId == request.auth.uid;
    }

    // =============================================
    // MILITARY & VETERANS
    // =============================================

    /**
     * Military Bases
     * Public read for all users
     */
    match /military_bases/{baseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /**
     * BAH Rates
     * Public read for military members
     */
    match /bah_rates/{rateId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    /**
     * Military User Profiles
     * Users manage their own profile
     */
    match /military_user_profiles/{userId} {
      allow read, write: if isAuthenticated()
        && userId == request.auth.uid;
    }

    /**
     * Property Base Proximity
     * Public read for property research
     */
    match /property_base_proximity/{propertyId} {
      allow read: if isAuthenticated();
      allow write: if false; // System calculated
    }

    /**
     * Relocation Assistance
     * Users manage their own relocation
     */
    match /relocation_assistance/{assistanceId} {
      allow read, write: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    // =============================================
    // ACCESSIBILITY
    // =============================================

    /**
     * Property Accessibility
     * Public read for property research
     * Agents/inspectors can update
     */
    match /property_accessibility/{propertyId} {
      allow read: if isAuthenticated();

      allow create, update: if isAuthenticated()
        && (hasAnyRole(['agent', 'inspector', 'admin', 'super_admin'])
            || get(/databases/$(database)/documents/properties/$(propertyId)).data.metadata.agentId == request.auth.uid);
    }

    /**
     * Accessibility Requirements
     * Users manage their own requirements
     */
    match /accessibility_requirements/{userId} {
      allow read, write: if isAuthenticated()
        && userId == request.auth.uid;
    }

    /**
     * Accessibility Checklists
     * Inspectors create, users can read for their properties
     */
    match /accessibility_checklists/{checklistId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && hasAnyRole(['inspector', 'agent', 'admin']);

      allow update: if isAuthenticated()
        && resource.data.inspectedBy == request.auth.uid;
    }

    // =============================================
    // CONVERSATIONAL ONBOARDING
    // =============================================

    /**
     * Onboarding Conversations
     * Users can manage their own onboarding conversations
     */
    match /onboarding_conversations/{conversationId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      // Users can update their own conversations (add messages, update stage)
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid;

      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    /**
     * Natural Language Queries
     * Users can read their own query parses
     */
    match /nl_queries/{queryId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      // Immutable after creation
      allow update, delete: if false;
    }

    /**
     * Search Agents (from onboarding)
     * Users can manage their own search agents
     */
    match /search_agents/{agentId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      // Users can update criteria, weights, and active status
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid;

      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    /**
     * Generated Questions
     * System-generated questions during onboarding
     * Read-only for users
     */
    match /generated_questions/{questionId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;

      // Only functions create questions
      allow create, update, delete: if false;
    }

    /**
     * Conversation Context
     * Users can read their own context
     */
    match /conversation_context/{contextId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;

      // Only functions update context
      allow create, update, delete: if false;
    }

    /**
     * Smart Suggestions
     * Users can view and respond to suggestions
     */
    match /smart_suggestions/{suggestionId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;

      // Users can mark suggestions as applied/dismissed
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['appliedAt', 'dismissedAt', 'userResponse']);

      // Only functions create suggestions
      allow create, delete: if false;
    }

    /**
     * Onboarding Templates
     * Public read for all users
     * Admins can manage templates
     */
    match /onboarding_templates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    /**
     * Search Agent Results
     * Users can read results from their agents
     */
    match /search_agent_results/{resultId} {
      allow read: if isAuthenticated()
        && (get(/databases/$(database)/documents/search_agents/$(resource.data.agentId)).data.userId == request.auth.uid);

      // Only functions create results
      allow create, update, delete: if false;
    }

    /**
     * Onboarding Analytics
     * Admins can read onboarding metrics
     */
    match /onboarding_analytics/{analyticsId} {
      allow read: if isAdmin();
      allow write: if false; // Generated by functions
    }

    // =============================================
    // ENHANCED AGENT ANALYTICS
    // =============================================

    /**
     * Predictive Lead Scores
     * Agents can read scores for their own leads
     */
    match /predictive_lead_scores/{scoreId} {
      allow read: if isAuthenticated()
        && resource.data.agentId == request.auth.uid;
      allow write: if false; // Generated by ML functions
    }

    /**
     * Marketing Channel Performance
     * Agents can read their own performance data
     */
    match /marketing_channel_performance/{performanceId} {
      allow read: if isAuthenticated()
        && resource.data.agentId == request.auth.uid;
      allow write: if false; // Generated by analytics functions
    }

    /**
     * Agent ROI Dashboards
     * Agents can read their own ROI dashboard
     */
    match /agent_roi_dashboards/{agentId} {
      allow read: if isAuthenticated()
        && agentId == request.auth.uid;
      allow write: if false; // Generated by analytics functions
    }

    /**
     * Listing A/B Tests
     * Agents can manage A/B tests for their own listings
     */
    match /listing_ab_tests/{testId} {
      allow read: if isAuthenticated()
        && resource.data.agentId == request.auth.uid;
      allow create, update: if isAuthenticated()
        && request.resource.data.agentId == request.auth.uid;
      allow delete: if isAuthenticated()
        && resource.data.agentId == request.auth.uid;
    }

    /**
     * Agent Benchmarks
     * Agents can read their own benchmarks
     */
    match /agent_benchmarks/{agentId} {
      allow read: if isAuthenticated()
        && agentId == request.auth.uid;
      allow write: if false; // Generated by analytics functions
    }

    // =============================================
    // COMMUNITY & NEIGHBORHOOD REVIEWS
    // =============================================

    /**
     * Neighborhood Reviews
     * Public read for all authenticated users
     * Users can create/update their own reviews
     */
    match /neighborhood_reviews/{reviewId} {
      allow read: if isAuthenticated()
        && resource.data.status == 'approved';

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid;

      allow delete: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    /**
     * Neighborhood Insights Summary
     * Public read for authenticated users
     */
    match /neighborhood_insights_summary/{neighborhoodId} {
      allow read: if isAuthenticated();
      allow write: if false; // Generated by aggregation functions
    }

    /**
     * Neighborhood Questions
     * Public read and create for authenticated users
     */
    match /neighborhood_questions/{questionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    /**
     * Neighborhood Answers
     * Public read for authenticated users
     * Users can create/update their own answers
     */
    match /neighborhood_answers/{answerId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    /**
     * Local Expert Profiles
     * Public read for authenticated users
     * Users can create/manage their own profile
     */
    match /local_expert_profiles/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated()
        && userId == request.auth.uid;
      allow delete: if isAuthenticated()
        && (userId == request.auth.uid || isAdmin());
    }

    /**
     * Resident Stories
     * Public read for published stories
     * Users can manage their own stories
     */
    match /resident_stories/{storyId} {
      allow read: if isAuthenticated()
        && resource.data.status == 'published';
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // =============================================
    // PROPERTY COMPARISON
    // =============================================

    /**
     * Property Comparisons
     * Users can manage their own comparisons
     */
    match /property_comparisons/{comparisonId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid
            || (resource.data.shared == true && resource.data.shareLink != null));
      allow create, update, delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    /**
     * Comparison Analyses
     * Read access tied to parent comparison
     */
    match /comparison_analyses/{analysisId} {
      allow read: if isAuthenticated()
        && (get(/databases/$(database)/documents/property_comparisons/$(resource.data.comparisonId)).data.userId == request.auth.uid
            || get(/databases/$(database)/documents/property_comparisons/$(resource.data.comparisonId)).data.shared == true);
      allow write: if false; // Generated by functions
    }

    /**
     * Comparison Reports
     * Users can read and manage their own reports
     */
    match /comparison_reports/{reportId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid
            || request.auth.token.email in resource.data.sharedWith);
      allow create, update, delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    // =============================================
    // SAVED SEARCHES & NOTIFICATIONS
    // =============================================

    /**
     * Saved Searches
     * Users can manage their own saved searches
     */
    match /saved_searches/{searchId} {
      allow read, create, update, delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    /**
     * Search Matches
     * Users can read matches for their own searches
     */
    match /search_matches/{matchId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['actions', 'notificationSent', 'notificationSentAt']);
      allow create, delete: if false; // Generated by functions
    }

    /**
     * Smart Notifications (search-related)
     * Users can read their own notifications
     */
    match /smart_notifications/{notificationId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['opened', 'openedAt', 'clicked', 'clickedAt', 'actionsTaken']);
      allow create, delete: if false; // Generated by functions
    }

    /**
     * Search Market Updates
     * Users can read updates for their own searches
     */
    match /search_market_updates/{updateId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow write: if false; // Generated by functions
    }

    // =============================================
    // ENVIRONMENTAL & CLIMATE DATA
    // =============================================

    /**
     * Flood Risk Data
     * Public read for authenticated users
     */
    match /flood_risk/{propertyId} {
      allow read: if isAuthenticated();
      allow write: if false; // Updated via API integrations
    }

    /**
     * Wildfire Risk Data
     * Public read for authenticated users
     */
    match /wildfire_risk/{propertyId} {
      allow read: if isAuthenticated();
      allow write: if false; // Updated via API integrations
    }

    /**
     * Earthquake Risk Data
     * Public read for authenticated users
     */
    match /earthquake_risk/{propertyId} {
      allow read: if isAuthenticated();
      allow write: if false; // Updated via API integrations
    }

    /**
     * Air Quality Data
     * Public read for authenticated users
     */
    match /air_quality/{propertyId} {
      allow read: if isAuthenticated();
      allow write: if false; // Updated via API integrations
    }

    /**
     * Climate Profiles
     * Public read for authenticated users
     */
    match /climate_profiles/{propertyId} {
      allow read: if isAuthenticated();
      allow write: if false; // Updated via API integrations
    }

    /**
     * Environmental Hazards
     * Public read for authenticated users
     */
    match /environmental_hazards/{propertyId} {
      allow read: if isAuthenticated();
      allow write: if false; // Updated via API integrations
    }

    /**
     * Sustainability Profiles
     * Public read for authenticated users
     * Agents can update for their own properties
     */
    match /sustainability_profiles/{propertyId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated()
        && (hasAnyRole(['agent', 'admin'])
            || get(/databases/$(database)/documents/properties/$(propertyId)).data.metadata.agentId == request.auth.uid);
      allow delete: if isAdmin();
    }

    /**
     * Environmental Risk Reports
     * Public read for authenticated users
     */
    match /environmental_risk_reports/{propertyId} {
      allow read: if isAuthenticated();
      allow write: if false; // Generated by aggregation functions
    }

    // =============================================
    // VIRTUAL TOURS & AR/VR
    // =============================================

    /**
     * Virtual Tours
     * Public read for authenticated users
     * Agents can manage tours for their own properties
     */
    match /virtual_tours/{tourId} {
      allow read: if isAuthenticated()
        && resource.data.status == 'active';
      allow create, update: if isAuthenticated()
        && (resource.data.agentId == request.auth.uid
            || hasAnyRole(['agent', 'admin']));
      allow delete: if isAuthenticated()
        && (resource.data.agentId == request.auth.uid || isAdmin());
    }

    /**
     * AR Visualizations
     * Users can manage their own AR sessions
     */
    match /ar_visualizations/{visualizationId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid
            || request.auth.uid in resource.data.sharedWith);
      allow create, update, delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    /**
     * Live Tour Schedules
     * Participants can read tour details
     * Agents can create and manage tours
     */
    match /live_tour_schedules/{scheduleId} {
      allow read: if isAuthenticated()
        && (resource.data.agentId == request.auth.uid
            || request.auth.uid in resource.data.attendees.map(a => a.userId));
      allow create: if isAuthenticated()
        && request.resource.data.agentId == request.auth.uid;
      allow update: if isAuthenticated()
        && (resource.data.agentId == request.auth.uid
            || request.auth.uid in resource.data.attendees.map(a => a.userId));
      allow delete: if isAuthenticated()
        && (resource.data.agentId == request.auth.uid || isAdmin());
    }

    /**
     * Tour Analytics
     * Property agents can read analytics for their properties
     */
    match /tour_analytics/{propertyId} {
      allow read: if isAuthenticated()
        && (get(/databases/$(database)/documents/properties/$(propertyId)).data.metadata.agentId == request.auth.uid
            || isAdmin());
      allow write: if false; // Generated by analytics functions
    }

    /**
     * Tour Packages
     * Agents can manage packages for their own properties
     */
    match /tour_packages/{packageId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated()
        && request.resource.data.agentId == request.auth.uid;
      allow delete: if isAuthenticated()
        && (resource.data.agentId == request.auth.uid || isAdmin());
    }

    /**
     * Tour Viewer Sessions
     * Analytics data - write access restricted to functions
     */
    match /tour_viewer_sessions/{sessionId} {
      allow read: if false; // Privacy - only aggregated analytics exposed
      allow write: if false; // Created by tracking functions
    }

    // =============================================
    // COMPREHENSIVE REAL ESTATE PLATFORM FEATURES
    // =============================================

    // RELOCATION & MOVING
    match /moving_plans/{planId} {
      allow read, create, update, delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    match /moving_quotes/{quoteId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false; // Created by service providers
    }

    match /utility_services/{serviceId} {
      allow read, create, update, delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    match /change_of_address/{addressId} {
      allow read, create, update, delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    match /moving_checklists/{checklistId} {
      allow read, create, update, delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    match /storage_facilities/{facilityId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // HOME SERVICES MARKETPLACE
    match /service_providers/{providerId} {
      allow read: if isAuthenticated()
        && resource.data.status == 'active';
      allow create, update: if isAuthenticated()
        && request.resource.data.id == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /service_requests/{requestId} {
      allow read, create, update, delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    match /service_quotes/{quoteId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid
            || resource.data.providerId == request.auth.uid);
      allow create, update: if isAuthenticated()
        && request.resource.data.providerId == request.auth.uid;
      allow delete: if isAuthenticated()
        && resource.data.providerId == request.auth.uid;
    }

    match /service_reviews/{reviewId} {
      allow read: if isAuthenticated()
        && resource.data.status == 'approved';
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /home_warranty_plans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /home_insurance_quotes/{quoteId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow create, update, delete: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
    }

    // MORTGAGE & FINANCING
    match /mortgage_lenders/{lenderId} {
      allow read: if isAuthenticated()
        && resource.data.status == 'active';
      allow write: if isAdmin();
    }

    match /mortgage_rate_quotes/{quoteId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow create, update: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if false; // Preserve for history
    }

    match /pre_approval_applications/{applicationId} {
      allow read, create, update: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated()
        && (resource.data.userId == request.auth.uid
            && resource.data.status == 'draft');
    }

    match /down_payment_assistance/{programId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // CRIME & SAFETY
    match /neighborhood_crime_stats/{neighborhoodId} {
      allow read: if isAuthenticated();
      allow write: if false; // Updated via API
    }

    match /property_crime_analysis/{propertyId} {
      allow read: if isAuthenticated();
      allow write: if false; // Generated by functions
    }

    match /sex_offender_data/{propertyId} {
      allow read: if isAuthenticated();
      allow write: if false; // Updated via API
    }

    match /emergency_services/{propertyId} {
      allow read: if isAuthenticated();
      allow write: if false; // Public data
    }

    match /school_safety/{schoolId} {
      allow read: if isAuthenticated();
      allow write: if false; // Public data
    }

    match /safety_reports/{propertyId} {
      allow read: if isAuthenticated();
      allow write: if false; // Generated by functions
    }

    // TRANSPORTATION & COMMUTE
    match /commute_analyses/{analysisId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || resource.data.userId == null);
      allow create, update, delete: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
    }

    match /multi_destination_commutes/{commuteId} {
      allow read, create, update, delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    match /parking_analysis/{propertyId} {
      allow read: if isAuthenticated();
      allow write: if false; // Generated by functions
    }

    match /walk_transit_scores/{propertyId} {
      allow read: if isAuthenticated();
      allow write: if false; // Updated via API
    }

    // DUE DILIGENCE
    match /ownership_history/{propertyId} {
      allow read: if isAuthenticated();
      allow write: if false; // Public records
    }

    match /permit_history/{propertyId} {
      allow read: if isAuthenticated();
      allow write: if false; // Public records
    }

    match /violation_history/{propertyId} {
      allow read: if isAuthenticated();
      allow write: if false; // Public records
    }

    match /hoa_information/{propertyId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated()
        && (hasAnyRole(['agent', 'admin'])
            || get(/databases/$(database)/documents/properties/$(propertyId)).data.metadata.agentId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /lien_encumbrance/{propertyId} {
      allow read: if isAuthenticated();
      allow write: if false; // Title company data
    }

    match /due_diligence_reports/{propertyId} {
      allow read: if isAuthenticated();
      allow write: if false; // Generated by functions
    }

    // LIFESTYLE
    match /smart_home_readiness/{propertyId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated()
        && (hasAnyRole(['agent', 'admin'])
            || get(/databases/$(database)/documents/properties/$(propertyId)).data.metadata.agentId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /pet_friendly_analysis/{propertyId} {
      allow read: if isAuthenticated();
      allow write: if false; // Generated by functions
    }

    match /pet_moving_checklists/{checklistId} {
      allow read, create, update, delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    // TRANSACTIONS & CLOSING
    match /real_estate_transactions/{transactionId} {
      allow read: if isAuthenticated()
        && (resource.data.buyerId == request.auth.uid
            || resource.data.sellerId == request.auth.uid
            || resource.data.parties.buyerAgent.id == request.auth.uid
            || resource.data.parties.sellerAgent.id == request.auth.uid
            || isAdmin());
      allow create: if isAuthenticated()
        && (request.resource.data.buyerId == request.auth.uid
            || request.resource.data.parties.buyerAgent.id == request.auth.uid);
      allow update: if isAuthenticated()
        && (resource.data.buyerId == request.auth.uid
            || resource.data.parties.buyerAgent.id == request.auth.uid
            || isAdmin());
      allow delete: if isAdmin();
    }

    match /purchase_offers/{offerId} {
      allow read: if isAuthenticated()
        && (resource.data.buyerId == request.auth.uid
            || get(/databases/$(database)/documents/real_estate_transactions/$(resource.data.transactionId)).data.sellerId == request.auth.uid
            || isAdmin());
      allow create, update: if isAuthenticated()
        && request.resource.data.buyerId == request.auth.uid;
      allow delete: if isAuthenticated()
        && resource.data.buyerId == request.auth.uid
        && resource.data.status == 'draft';
    }

    match /contingency_trackers/{transactionId} {
      allow read: if isAuthenticated()
        && (get(/databases/$(database)/documents/real_estate_transactions/$(transactionId)).data.buyerId == request.auth.uid
            || get(/databases/$(database)/documents/real_estate_transactions/$(transactionId)).data.sellerId == request.auth.uid
            || isAdmin());
      allow update: if isAuthenticated()
        && (get(/databases/$(database)/documents/real_estate_transactions/$(transactionId)).data.buyerId == request.auth.uid
            || get(/databases/$(database)/documents/real_estate_transactions/$(transactionId)).data.parties.buyerAgent.id == request.auth.uid);
      allow create, delete: if false; // System managed
    }

    match /closing_costs/{transactionId} {
      allow read: if isAuthenticated()
        && (get(/databases/$(database)/documents/real_estate_transactions/$(transactionId)).data.buyerId == request.auth.uid
            || isAdmin());
      allow write: if false; // Generated by lender/title company
    }

    match /transaction_timelines/{transactionId} {
      allow read: if isAuthenticated()
        && (get(/databases/$(database)/documents/real_estate_transactions/$(transactionId)).data.buyerId == request.auth.uid
            || get(/databases/$(database)/documents/real_estate_transactions/$(transactionId)).data.sellerId == request.auth.uid
            || isAdmin());
      allow write: if false; // System managed
    }

    match /final_walkthroughs/{walkthroughId} {
      allow read: if isAuthenticated()
        && (resource.data.transactionId != null
            && (get(/databases/$(database)/documents/real_estate_transactions/$(resource.data.transactionId)).data.buyerId == request.auth.uid
                || isAdmin()));
      allow create, update: if isAuthenticated()
        && (get(/databases/$(database)/documents/real_estate_transactions/$(request.resource.data.transactionId)).data.buyerId == request.auth.uid
            || isAdmin());
      allow delete: if isAdmin();
    }

    match /closing_day/{transactionId} {
      allow read: if isAuthenticated()
        && (get(/databases/$(database)/documents/real_estate_transactions/$(transactionId)).data.buyerId == request.auth.uid
            || get(/databases/$(database)/documents/real_estate_transactions/$(transactionId)).data.sellerId == request.auth.uid
            || isAdmin());
      allow write: if false; // System managed
    }

    // =============================================
    // DEFAULT DENY
    // =============================================

    /**
     * Deny all other access by default
     * Explicit security: only allow what's explicitly permitted
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
