rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Houses collection - read public, write authenticated
    match /houses/{houseId} {
      allow read: if true; // Public read for all property listings
      allow write: if request.auth != null; // Only authenticated users can write

      // Allow create/update with validation
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasAll(['id', 'source', 'price', 'title'])
        && request.resource.data.price > 0;
    }

    // Search requests - user-specific
    match /search-requests/{requestId} {
      allow read, write: if request.auth != null
        && request.auth.uid == resource.data.userId;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['status', 'createdAt']);
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
